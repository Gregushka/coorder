{% extends 'base.html.twig' %}

{% block title %}Edit Trip - {{ trip.name }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        .form-error {
            color: #dc3545;
            font-size: 0.875em;
            margin-top: 0.25rem;
        }
        .is-invalid {
            border-color: #dc3545 !important;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h2 class="h4 mb-0">Edit Trip: {{ trip.name }}</h2>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                    
                    <div class="mb-3">
                        {{ form_label(form.name) }}
                        {{ form_widget(form.name, {'attr': {'class': 'form-control' ~ (form.name.vars.errors|length ? ' is-invalid' : '')}}) }}
                        {% if form.name.vars.errors %}
                            <div class="form-error">
                                {{ form_errors(form.name) }}
                            </div>
                        {% endif %}
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.dateBegin) }}
                            {{ form_widget(form.dateBegin, {'attr': {'class': 'form-control' ~ (form.dateBegin.vars.errors|length ? ' is-invalid' : '')}}) }}
                            {% if form.dateBegin.vars.errors %}
                                <div class="form-error">
                                    {{ form_errors(form.dateBegin) }}
                                </div>
                            {% endif %}
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.dateEnd) }}
                            {{ form_widget(form.dateEnd, {'attr': {'class': 'form-control' ~ (form.dateEnd.vars.errors|length ? ' is-invalid' : '')}}) }}
                            {% if form.dateEnd.vars.errors %}
                                <div class="form-error">
                                    {{ form_errors(form.dateEnd) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        {{ form_label(form.description) }}
                        {{ form_widget(form.description, {'attr': {'class': 'form-control' ~ (form.description.vars.errors|length ? ' is-invalid' : '')}}) }}
                        {% if form.description.vars.errors %}
                            <div class="form-error">
                                {{ form_errors(form.description) }}
                            </div>
                        {% endif %}
                    </div>
                    
                    <div class="d-flex justify-content-between mt-4">
                        <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#discardModal">
                            Discard Changes
                        </button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Discard Modal -->
<div class="modal fade" id="discardModal" tabindex="-1" aria-labelledby="discardModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="discardModalLabel">Confirm Discard</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to discard your changes? All unsaved changes will be lost.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No, Keep Editing</button>
                <a href="{{ path('app_main') }}" class="btn btn-danger">Yes, Discard Changes</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}