{% extends 'base.html.twig' %}

{% block title %}Media Files - {{ trip.name }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .table-actions {
            white-space: nowrap;
        }
        .table-actions .btn {
            margin: 0 2px;
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }
        .trip-info {
            background-color: #f8f9fa;
            border-radius: 0.375rem;
            padding: 1rem;
            margin-bottom: 1.5rem;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Media Files</h1>
            <div class="trip-info">
                <h5 class="mb-1">{{ trip.name }}</h5>
                <p class="mb-0 text-muted">
                    {{ trip.dateBegin|date('Y-m-d') }} to {{ trip.dateEnd|date('Y-m-d') }}
                    {% if trip.description %}
                        | {{ trip.description }}
                    {% endif %}
                </p>
            </div>
        </div>
        <div>
            <a href="{{ path('app_main') }}" class="btn btn-outline-secondary me-2">
                <i class="bi bi-arrow-left"></i> Back to Trips
            </a>
            <a href="{{ path('app_new_media', {'id': trip.id}) }}" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add Media
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Media ID</th>
                            <th>Created</th>
                            <th>Trip Name</th>
                            <th>Log Entries</th>
                            <th>Video Files</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for mediaCard in mediaCards %}
                        <tr>
                            <td>
                                <a href="#" class="text-decoration-none">
                                    {{ mediaCard.mediaId }}
                                </a>
                            </td>
                            <td>{{ mediaCard.mediaCreated|date('Y-m-d H:i') }}</td>
                            <td>{{ mediaCard.trip.name }}</td>
                            <td>
                                <span class="badge bg-info">{{ mediaCard.logfileDataEntries|length }}</span>
                            </td>
                            <td>
                                <span class="badge bg-success">{{ mediaCard.videoFileDatas|length }}</span>
                            </td>
                            <td class="table-actions">
                                <a href="#" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No media files found. <a href="{{ path('app_new_media', {'id': trip.id}) }}">Add your first media file</a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}