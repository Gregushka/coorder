{% extends 'base.html.twig' %}
{% block body %}
<div class="container mt-4">
    <h1>{{ trip.name }}</h1>
    <p><strong>Date:</strong> {{ trip.dateBegin|date('Y-m-d') }} to {{ trip.dateEnd|date('Y-m-d') }}</p>
    <p>{{ trip.description }}</p>
    <a href="{{ path('app_main') }}" class="btn btn-secondary">Back</a>
</div>
{% endblock %}