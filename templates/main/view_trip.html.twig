{% extends 'base.html.twig' %}

{% block title %}View Trip - {{ trip.name }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        .trip-details {
            background-color: #f8f9fa;
            border-radius: 0.375rem;
            padding: 2rem;
            margin-bottom: 2rem;
        }
        .detail-row {
            margin-bottom: 1rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #dee2e6;
        }
        .detail-row:last-child {
            border-bottom: none;
        }
        .detail-label {
            font-weight: 600;
            color: #495057;
        }
        .detail-value {
            color: #212529;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Trip Details</h1>
        <a href="{{ path('app_main') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Trips
        </a>
    </div>

    <div class="trip-details">
        <div class="detail-row">
            <div class="row">
                <div class="col-md-2 detail-label">Trip Name:</div>
                <div class="col-md-10 detail-value">{{ trip.name }}</div>
            </div>
        </div>
        
        <div class="detail-row">
            <div class="row">
                <div class="col-md-2 detail-label">Start Date:</div>
                <div class="col-md-10 detail-value">{{ trip.dateBegin|date('F j, Y') }}</div>
            </div>
        </div>
        
        <div class="detail-row">
            <div class="row">
                <div class="col-md-2 detail-label">End Date:</div>
                <div class="col-md-10 detail-value">{{ trip.dateEnd|date('F j, Y') }}</div>
            </div>
        </div>
        
        {% if trip.description %}
        <div class="detail-row">
            <div class="row">
                <div class="col-md-2 detail-label">Description:</div>
                <div class="col-md-10 detail-value">{{ trip.description }}</div>
            </div>
        </div>
        {% endif %}
        
        <div class="detail-row">
            <div class="row">
                <div class="col-md-2 detail-label">Media Files:</div>
                <div class="col-md-10 detail-value">
                    <span class="badge bg-primary">{{ trip.mediaCards|length }}</span>
                    {% if trip.mediaCards|length > 0 %}
                        <a href="{{ path('app_list_media', {'id': trip.id}) }}" class="btn btn-sm btn-outline-primary ms-2">
                            View Media Files
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
        
        <div class="detail-row">
            <div class="row">
                <div class="col-md-2 detail-label">Heavy Name:</div>
                <div class="col-md-10 detail-value">
                    <code>{{ trip.heavyName }}</code>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between">
        <a href="{{ path('app_edit_trip', {'id': trip.id}) }}" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Edit Trip
        </a>
        <a href="{{ path('app_list_media', {'id': trip.id}) }}" class="btn btn-success">
            <i class="bi bi-camera-video"></i> Manage Media
        </a>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}