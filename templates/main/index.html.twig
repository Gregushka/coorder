{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-4">
    <h1>Trip List</h1>
    <div class="mb-3">
        <a href="{{ path('app_new_trip') }}" class="btn btn-primary">Add Trip</a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Date Begin</th>
                <th>Date End</th>
                <th>Description</th>
                <th>Linked Media</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for trip in trips %}
            <tr>
                <td>
                    <a href="{{ path('app_view_trip', {id: trip.id}) }}">{{ trip.name }}</a>
                </td>
                <td>{{ trip.dateBegin|date('Y-m-d') }}</td>
                <td>{{ trip.dateEnd|date('Y-m-d') }}</td>
                <td>{{ trip.description|slice(0, 50) }}...</td>
                <td>{{ trip.mediaCards|length }}</td>
                <td>
                    <a href="{{ path('app_edit_trip', {id: trip.id}) }}" class="btn btn-sm btn-warning">Edit</a>
                    <a href="{{ path('app_list_media', {id: trip.id}) }}" class="btn btn-sm btn-info">Edit Media</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center">No trips found.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}