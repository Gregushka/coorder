{% extends 'base.html.twig' %}

{% block title %}Trips List{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .table-actions {
            white-space: nowrap;
        }
        .table-actions .btn {
            margin: 0 2px;
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Trip Management</h1>
        <a href="{{ path('app_new_trip') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Trip
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Description</th>
                            <th>Media Files</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for trip in trips %}
                        <tr>
                            <td>
                                <a href="{{ path('app_view_trip', {'id': trip.id}) }}" class="text-decoration-none">
                                    {{ trip.name }}
                                </a>
                            </td>
                            <td>{{ trip.dateBegin|date('Y-m-d') }}</td>
                            <td>{{ trip.dateEnd|date('Y-m-d') }}</td>
                            <td>
                                {% if trip.description %}
                                    {{ trip.description|length > 50 ? trip.description|slice(0, 50) ~ '...' : trip.description }}
                                {% else %}
                                    <span class="text-muted">No description</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge bg-primary">{{ trip.mediaCards|length }}</span>
                            </td>
                            <td class="table-actions">
                                <a href="{{ path('app_edit_trip', {'id': trip.id}) }}" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a href="{{ path('app_list_media', {'id': trip.id}) }}" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-camera-video"></i> Edit Media
                                </a>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No trips found. <a href="{{ path('app_new_trip') }}">Create your first trip</a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}